[Unit]
Description=manent daemon: ingest from Archived/*, file INBOX, close days
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/chome/santini/Activities/Programming/manent
ExecStart=/chome/santini/Activities/Programming/manent/.venv/bin/manent daemon
Restart=on-failure
RestartSec=30
UMask=0077

[Install]
WantedBy=default.target
