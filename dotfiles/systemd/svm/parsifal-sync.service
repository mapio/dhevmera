[Unit]
Description=Pull-only mirror sync of parsifal's qbt-repos to the local mirror

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/santini/.local/bin/uv run /home/santini/x/qbt/repos/parsifal-sync/sync.py
StandardOutput=append:/home/santini/parsifal-sync/service.log
StandardError=append:/home/santini/parsifal-sync/service.log
