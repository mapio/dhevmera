#!/usr/bin/env bash

set -eo pipefail

# Installs what this host carries by tag: its systemd --user units, its ssh key pairs, and
# its ~/.ssh/authorized_keys.
#
# Unlike the tool configs install-dotfiles deploys, which are wanted on every host this
# repo is cloned onto, these belong only to some hosts - backup-cloud's ExecStart and
# ytwit-bot's WorkingDirectory are both under /chome, which exists only on one machine.
#
# So they are filed by TAG: dotfiles/systemd/<tag>/, dotfiles/ssh/keys/<tag>/ and
# dotfiles/ssh/authorized_keys/<tag>. A tag is a role, not a hostname: these hosts are
# ephemeral enough that their names are not worth encoding. A host declares which tags it
# carries, and may carry several; this script installs the union.
#
#   install-host [--dry-run] [--prune] [--adopt] [--activate] [tag...]
#   install-host --confirm
#
# Tags come from the arguments, or - with none - from ~/.dhevmera-tags, one per line,
# blank lines and # comments ignored, each one of KNOWN_TAGS in install-common.sh. That
# file is host-local state and is not in this repo: it is the one thing that cannot roam,
# since it is precisely what distinguishes this host from the others.
#
# Units no longer claimed are pruned; key links only with --prune. authorized_keys is
# generated, and a change to it reverts itself unless confirmed: see that section.
# Units are always reloaded, and what systemd runs is checked against the repo; changing
# running state - enable, start, restart - needs --activate.

RUN=
PRUNE=
ADOPT=
CONFIRM=
ACTIVATE=
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --dry-run) RUN=echo ;;
    --prune) PRUNE=yes ;;
    --adopt) ADOPT=yes ;;
    --confirm) CONFIRM=yes ;;
    --activate) ACTIVATE=yes ;;
    -*) echo "usage: install-host [--dry-run] [--prune] [--adopt] [--activate] [tag...] | --confirm" >&2; exit 2 ;;
    *) ARGS+=("$arg") ;;
  esac
done

# Keep a log of the setup process

LOGFILE="$HOME/.install-host.log"
exec 3>&1
exec > >(tee -a "$LOGFILE") 2>&1

source "$(dirname "${BASH_SOURCE[0]}")/install-common.sh"

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
DOTFILES="$REPO/dotfiles"
SECRETS="$REPO/secrets"
UNITS="$DOTFILES/systemd"
DEST="$HOME/.config/systemd/user"
KEYS="$DOTFILES/ssh/keys"
TAGFILE="$HOME/.dhevmera-tags"
RESTART="$HOME/.install-host.restart"

AK="$HOME/.ssh/authorized_keys"
PENDING="$AK.pending"
MARKER="# Generated by dhevmera's install-host"
# The key that lets Massimo in: always first in authorized_keys, never removable by a tag.
GOLDEN_PUB="$DOTFILES/ssh/id_rsa.pub"
GOLDEN_FP="SHA256:owEnOy2joDxx07J4OhpkSg9zXRjiz6O+9HPU7WWsdVQ"
REVERT_AFTER=600

# --confirm: keep the authorized_keys change that is pending. Run it through a new ssh
# connection from another host - that the connection worked is what it confirms.

if [ -n "$CONFIRM" ]; then
  [ -n "${SSH_CONNECTION:-}" ] || die "--confirm must come through a new ssh connection from another host"
  if mv "$PENDING" "$PENDING.confirmed" 2>/dev/null; then
    rm -f "$PENDING.confirmed"
    ok "confirmed: $AK stays as it is"
  elif [ -e "$AK.reverted" ]; then
    die "too late: the change was reverted at $(stat -c %y "$AK.reverted")"
  else
    die "no authorized_keys change is pending here"
  fi
  exit 0
fi

# which tags does this host carry?

if [ ${#ARGS[@]} -gt 0 ]; then
  TAGS=("${ARGS[@]}")
  TAGSRC="the command line"
elif [ -r "$TAGFILE" ]; then
  mapfile -t TAGS < <(read_tags "$TAGFILE")
  TAGSRC="$TAGFILE"
else
  log "No tags for this host"
  warn "no tags given and no '$TAGFILE'"
  warn "tags available: ${KNOWN_TAGS[*]}"
  warn "declare this host's tags in '$TAGFILE', one per line, or pass them as arguments"
  exit 0
fi

if [ ${#TAGS[@]} -eq 0 ]; then
  log "No tags for this host"
  warn "'$TAGFILE' declares no tags"
  exit 0
fi

check_tags "${TAGS[@]}"

shopt -s nullglob

# --------------------------------------------------------------------------- units

log "Installing systemd --user units for tags: ${TAGS[*]} (from $TAGSRC)"

# Collect first, install second, so a collision is reported before anything on disk has
# been replaced. A tag without a directory under dotfiles/systemd/ simply has no units.

found=()

for tag in "${TAGS[@]}"; do
  for unit in "$UNITS/$tag"/*; do
    for seen in "${found[@]}"; do
      if [ "$(basename "$seen")" = "$(basename "$unit")" ]; then
        die "'$(basename "$unit")' appears in more than one tag ($seen and $unit)"
      fi
    done
    found+=("$unit")
  done
done

if [ ${#found[@]} -eq 0 ]; then
  warn "tags ${TAGS[*]} hold no units - nothing to install, pruning only"
fi

for unit in "${found[@]}"; do
  _install "$unit" "$DEST/$(basename "$unit")"
done

# Prune units this host no longer claims - a unit dropped from the repo, or moved to a tag
# this host does not carry. Three conditions before anything is removed, so the blast
# radius is exactly "links this script itself created":
#
#   - it is a symlink; a regular file in there was put there by hand and is never touched
#   - its target is inside dotfiles/systemd/, so units linked from elsewhere are left alone
#   - its basename is not among the units just installed
#
# The target test is a string prefix on the raw link, not realpath, so a unit whose file
# has already been deleted from the repo - a dangling link, the very case worth pruning -
# is still recognised as ours.

log "Pruning units no longer claimed by tags: ${TAGS[*]}"

pruned=()

for existing in "$DEST"/*; do

  [ -h "$existing" ] || continue

  target="$(readlink "$existing")"
  case "$target" in
    "$UNITS"/*) ;;
    *) continue ;;
  esac

  keep=

  for unit in "${found[@]}"; do
    if [ "$(basename "$unit")" = "$(basename "$existing")" ]; then
      keep=yes
      break
    fi
  done

  if [ -z "$keep" ]; then
    $RUN rm -f "$existing"
    ok "pruned: $existing"
    pruned+=("$(basename "$existing")")
  fi

done

if [ ${#pruned[@]} -eq 0 ]; then
  ok "nothing to prune"
else
  # Removing the unit file does not undo a previous 'systemctl --user enable': that leaves
  # its own link under *.target.wants/, which is systemd's to manage, not this script's.
  warn "${#pruned[@]} unit(s) pruned may still be enabled; disable them explicitly:"
  for name in "${pruned[@]}"; do
    echo "  systemctl --user disable $name"
  done
fi

# ----------------------------------------------------------------------- activation

# A linked unit is not a running one: make systemd's state match the repo, or say where it
# does not. Reloading touches no process, so it always runs; enable, start and restart
# change running state and wait for --activate. The unit files are all this can see: a
# code change in what a unit runs is that repo's own deploy step.

activate_units() {
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    warn "no systemd --user manager here - units linked, not activated"
    return
  fi

  # The reload would also apply a pending edit to a unit this script does not own: hold off.
  local unit name foreign=()
  while read -r name; do
    case " ${found[*]##*/} " in *" $name "*) continue ;; esac
    if [ "$(systemctl --user show -p NeedDaemonReload --value -- "$name")" = yes ]; then
      foreign+=("$name")
    fi
  done < <(systemctl --user list-units --all --plain --no-legend | sed 's/^● //' | awk '{print $1}')

  if [ ${#foreign[@]} -gt 0 ]; then
    warn "not reloading: units this script does not own have pending edits: ${foreign[*]}"
    warn "reload yourself once those edits are meant to apply, then re-run this"
    return
  fi
  # A running service keeps the definition it started with, and after the reload nothing
  # in systemd says so any more: note it now, and forget it once the service has restarted.
  local now since kept=()
  now="$(date +%s)"
  for unit in "${found[@]}"; do
    name="$(basename "$unit")"
    if [[ $name == *.service ]] &&
       [ "$(systemctl --user show -p ActiveState --value -- "$name")" = active ] &&
       [ "$(systemctl --user show -p NeedDaemonReload --value -- "$name")" = yes ]; then
      kept+=("$name $now")
    fi
  done
  if [ -r "$RESTART" ]; then
    while read -r name t; do
      since="$(systemctl --user show --timestamp=unix -p ActiveEnterTimestamp --value -- "$name")"
      case " ${found[*]##*/} " in *" $name "*) ;; *) continue ;; esac
      [ "$(systemctl --user show -p ActiveState --value -- "$name")" = active ] || continue
      [ "${since#@}" -lt "$t" ] || continue
      case " ${kept[*]} " in *" $name "*) ;; *) kept+=("$name $t") ;; esac
    done < "$RESTART"
  fi
  if [ -z "$RUN" ]; then
    if [ ${#kept[@]} -gt 0 ]; then printf '%s\n' "${kept[@]}" > "$RESTART"; else rm -f "$RESTART"; fi
  fi

  $RUN systemctl --user daemon-reload
  ok "reloaded"

  local todo=() line state active wants t w target
  for unit in "${found[@]}"; do
    name="$(basename "$unit")"
    active="$(systemctl --user show -p ActiveState --value -- "$name")"

    if grep -q '^\[Install\]' "$unit"; then
      state="$(systemctl --user is-enabled -- "$name" 2>/dev/null || true)"
      wants=ok
      for t in $(sed -n 's/^WantedBy=//p' "$unit"); do
        w="$DEST/$t.wants/$name"
        target="$(readlink -f "$w" 2>/dev/null || true)"
        if [ ! -e "$w" ] || [ "$target" != "$unit" ]; then wants=bad; fi
      done
      if [ "$state" != enabled ]; then
        todo+=("enable $name|not enabled ($state)")
      elif [ $wants = bad ]; then
        todo+=("enable $name|.wants link missing or not pointing at $unit")
      fi
      if [ "$active" != active ]; then
        todo+=("start $name|$active")
        continue
      fi
    fi

    # A timer is rescheduled by the reload alone, and a oneshot a timer pulls in picks up
    # its new definition on its next run: only a running service keeps the old one.
    case " ${kept[*]} " in *" $name "*)
      todo+=("restart $name|running a definition older than its unit file") ;;
    esac
  done

  if [ ${#todo[@]} -eq 0 ]; then
    ok "all ${#found[@]} unit(s) enabled and current"
  elif [ -n "$ACTIVATE" ]; then
    for line in "${todo[@]}"; do
      $RUN systemctl --user ${line%%|*}
      ok "${line%%|*}: ${line#*|}"
    done
  else
    warn "${#todo[@]} unit action(s) pending; re-run with --activate, or by hand:"
    for line in "${todo[@]}"; do
      echo "  systemctl --user ${line%%|*}    # ${line#*|}"
    done
  fi

  if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]; then
    warn "lingering is off: these units stop at logout and timers miss their schedule"
    echo "  loginctl enable-linger $USER"
  fi
}

if [ ${#found[@]} -gt 0 ]; then
  log "Activating units for tags: ${TAGS[*]}"
  activate_units
fi

# ------------------------------------------------------------------------ key pairs

# dotfiles/ssh/keys/<tag>/<name>.pub is the public half; the private one is
# secrets/ssh/<name>. id_rsa is not here: install-dotfiles gives it to every host.

log "Installing ssh key pairs for tags: ${TAGS[*]}"

# Replacing a hand-placed key file is fine only if the repo holds the same key.
install_key() {
  if [ -f "$2" ] && [ ! -h "$2" ] && ! cmp -s "$1" "$2"; then
    die "'$2' is a different key from '$1': move it aside first"
  fi
  _install "$1" "$2"
}

claimed=()

for tag in "${TAGS[@]}"; do
  for pub in "$KEYS/$tag"/*.pub; do
    name=$(basename "$pub" .pub)
    for seen in "${claimed[@]}"; do
      [ "$seen" = "$name" ] && die "key '$name' appears in more than one tag"
    done
    claimed+=("$name")
    install_key "$pub" "$HOME/.ssh/$name.pub"
    if [ -f "$SECRETS/ssh/$name" ]; then
      install_key "$SECRETS/ssh/$name" "$HOME/.ssh/$name"
    else
      warn "no private half '$SECRETS/ssh/$name': unpack a current secrets snapshot"
    fi
  done
done

[ ${#claimed[@]} -gt 0 ] || ok "tags ${TAGS[*]} hold no key pairs"

# A link into dotfiles/ssh/ or secrets/ssh/ that no tag claims is reported, and removed
# only with --prune. id_rsa and install-dotfiles' own links (config, ...) are left alone.

log "Checking for key links no longer claimed by tags: ${TAGS[*]}"

for link in "$HOME"/.ssh/*; do
  target=$(readlink "$link") || continue
  case "$target" in
    "$DOTFILES"/ssh/* | "$SECRETS"/ssh/*) ;;
    *) continue ;;
  esac
  name=$(basename "$link")
  case "$name" in id_rsa | id_rsa.pub) continue ;; esac
  for seen in "${claimed[@]}"; do
    [ "$name" = "$seen" ] || [ "$name" = "$seen.pub" ] && continue 2
  done
  case "$target" in
    "$KEYS"/* | "$SECRETS"/ssh/*) ;;
    *) [ -e "$link" ] && continue ;;
  esac
  if [ -n "$PRUNE" ]; then
    $RUN rm "$link"
    ok "removed: $link"
  else
    warn "unclaimed: $link -> $target (re-run with --prune to remove it)"
  fi
done

# ------------------------------------------------------------------ authorized_keys
#
# Some hosts are key-only, so a bad authorized_keys is a lockout. Hence:
#   - the golden key always comes first, checked against GOLDEN_FP; no tag can drop it
#   - every line must parse, with no duplicates, before anything is written
#   - a file this script did not generate is replaced only with --adopt
#   - the golden key must already log in here over loopback, or nothing is changed
#   - the swap is atomic, a backup is kept, and a job restores it after REVERT_AFTER
#     seconds unless 'install-host --confirm' arrives through a new ssh connection
#   - if the loopback login fails after the swap, the backup goes back at once

# Restores the backup named in PENDING unless --confirm has claimed PENDING first: mv
# makes either claim atomic. A file of its own, because systemd-run would expand the $s.
REVERT_SH='umask 077
sleep "$4"
mv "$2" "$2.firing" 2>/dev/null || exit 0
b=$(cat "$2.firing")
if [ "$b" = - ]; then rm -f "$1"; else cp -p "$b" "$1.revert" && mv -f "$1.revert" "$1"; fi
rm -f "$2.firing"
touch "$1.reverted"
echo "$(date): reverted $1 to $b" >>"$3"
'

golden_login() {
  ssh -F /dev/null -o IdentityAgent="$AGENT" -o IdentitiesOnly=yes -i "$GOLDEN_PUB" \
    -o PreferredAuthentications=publickey -o BatchMode=yes -o ConnectTimeout=10 \
    -o ControlMaster=no -o ControlPath=none -o LogLevel=ERROR \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -p "$SSHD_PORT" "$(id -un)@127.0.0.1" true </dev/null
}

fix_mode() {
  local mode
  mode=$(stat -c %a "$1")
  if [ "$mode" != "$2" ]; then
    $RUN chmod "$2" "$1"
    warn "$1 was mode $mode: set to $2"
  fi
}

authorized_keys() {
  local keys fps dups conf confs c f managed sock backup sh baks
  # Everything created in ~/.ssh from here is owner-only, whatever the host's umask.
  umask 077

  if [ -e "$AK.reverted" ]; then
    warn "a previous authorized_keys change was reverted at $(stat -c %y "$AK.reverted")"
    $RUN rm -f "$AK.reverted"
  fi
  if [ -e "$PENDING" ]; then
    warn "an authorized_keys change is still pending: confirm it or let it revert, then re-run"
    return
  fi

  [ "$(ssh-keygen -lf "$GOLDEN_PUB" | awk '{print $2}')" = "$GOLDEN_FP" ] \
    || die "'$GOLDEN_PUB' is not the golden key $GOLDEN_FP"
  [ "$(stat -c %u "$HOME/.ssh")" = "$(id -u)" ] || die "~/.ssh is not owned by $(id -un)"
  [ ! -h "$AK" ] || die "'$AK' is a symlink: sshd would check the target's directories too"

  # What sshd enforces under StrictModes, fixed rather than merely reported.
  if [ -n "$(find "$HOME" -maxdepth 0 -perm /022)" ]; then
    $RUN chmod go-w "$HOME"
    warn "home was group/other-writable: made it go-w"
  fi
  fix_mode "$HOME/.ssh" 700
  [ ! -f "$AK" ] || fix_mode "$AK" 600

  # sshd's effective settings: sshd -T needs root, so fall back to the files it can read.
  if SSHD_T=$(sudo -n sshd -T -C "user=$(id -un),host=localhost,addr=127.0.0.1" 2>/dev/null); then
    SSHD_PORT=$(awk '$1 == "port" {print $2; exit}' <<<"$SSHD_T")
    AKFILES=$(awk '$1 == "authorizedkeysfile" {$1 = ""; print; exit}' <<<"$SSHD_T")
  else
    conf="${PREFIX:-}/etc/ssh/sshd_config"
    confs=("$conf" "$conf".d/*.conf)
    for c in "${confs[@]}"; do
      [ -r "$c" ] || warn "cannot read '$c': its settings are not checked"
    done
    SSHD_PORT=$(cat "${confs[@]}" 2>/dev/null | awk 'tolower($1) == "port" {print $2; exit}')
    AKFILES=$(cat "${confs[@]}" 2>/dev/null | awk 'tolower($1) == "authorizedkeysfile" {$1 = ""; print; exit}')
  fi
  case "${PREFIX:-}" in
    *com.termux*) : "${SSHD_PORT:=8022}" ;;
    *) : "${SSHD_PORT:=22}" ;;
  esac
  : "${AKFILES:=.ssh/authorized_keys .ssh/authorized_keys2}"
  managed=
  for f in $AKFILES; do
    case "$f" in
      .ssh/authorized_keys | %h/.ssh/authorized_keys | "$HOME"/.ssh/authorized_keys) managed=yes ;;
      *) [ ! -e "$HOME/${f#%h/}" ] || warn "sshd also reads '$f', which this script does not manage" ;;
    esac
  done
  [ -n "$managed" ] || die "sshd does not read ~/.ssh/authorized_keys (AuthorizedKeysFile $AKFILES)"

  # Global, for the EXIT trap: a RETURN trap would fire on every function return after it.
  candidate=$(mktemp "$HOME/.ssh/authorized_keys.XXXXXX")
  trap 'rm -f "$candidate"' EXIT
  {
    echo "$MARKER for tags: ${TAGS[*]}."
    echo "# Edit dotfiles/ssh/authorized_keys/<tag> in the repo, not this file."
    cat "$GOLDEN_PUB"
    for tag in "${TAGS[@]}"; do
      if [ -f "$DOTFILES/ssh/authorized_keys/$tag" ]; then
        sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$DOTFILES/ssh/authorized_keys/$tag"
      fi
    done
  } >"$candidate"

  # ssh-keygen skips a line it cannot parse without failing, so compare the counts.
  keys=$(grep -cv -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$candidate")
  fps=$(ssh-keygen -lf "$candidate" | awk '{print $2}')
  [ "$(grep -c . <<<"$fps")" = "$keys" ] || die "some lines for tags ${TAGS[*]} are not valid keys"
  grep -qxF "$GOLDEN_FP" <<<"$fps" || die "the golden key is missing from the generated file"
  dups=$(sort <<<"$fps" | uniq -d)
  [ -z "$dups" ] || die "duplicate keys: $dups"

  if [ -f "$AK" ] && cmp -s "$candidate" "$AK"; then
    ok "$AK is up to date"
    return
  fi
  if [ -f "$AK" ]; then
    diff -u "$AK" "$candidate" || true
  else
    cat "$candidate"
  fi
  if [ -z "$ADOPT" ] && ! { [ -f "$AK" ] && head -1 "$AK" | grep -qF "$MARKER"; }; then
    warn "$AK was not generated by this script: the above is what --adopt would write"
    return
  fi

  # The loopback login bypasses ~/.ssh/config and any master connection: only a new login
  # makes sshd read authorized_keys, and only the golden key, from an agent, is offered.
  "$HOME/.ssh/refresh-agent-link.sh" >/dev/null 2>&1 || true
  AGENT=
  for sock in "${SSH_AUTH_SOCK:-}" "$HOME/.ssh/agent-link"; do
    if [ -n "$sock" ] && SSH_AUTH_SOCK="$sock" ssh-add -l 2>/dev/null | grep -qF "$GOLDEN_FP"; then
      AGENT="$sock"
      break
    fi
  done
  if [ -z "$AGENT" ]; then
    warn "no agent holds the golden key, so the change could not be tested: left unchanged"
    return
  fi
  if ! golden_login; then
    warn "the golden key cannot log in over loopback (port $SSHD_PORT) even now: left unchanged"
    return
  fi
  if [ -n "$RUN" ]; then
    ok "dry run: the golden key logs in now; $AK would be replaced, tested and armed to revert"
    return
  fi

  backup=-
  if [ -f "$AK" ]; then
    backup="$AK.bak-$(date +%Y%m%dT%H%M%S)"
    cp -p "$AK" "$backup"
  fi
  printf '%s' "$REVERT_SH" >"$AK.revert.sh"
  echo "$backup" >"$PENDING.tmp"
  mv -f "$PENDING.tmp" "$PENDING"

  sh=$(command -v sh)
  if command -v systemd-run >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
    systemd-run --user --quiet --on-active="$REVERT_AFTER" \
      "$sh" "$AK.revert.sh" "$AK" "$PENDING" "$LOGFILE" 0
  else
    # 3>&- too: fd 3 is the caller's stdout, and holding it would hang an 'ssh host install-host'.
    setsid nohup "$sh" "$AK.revert.sh" "$AK" "$PENDING" "$LOGFILE" "$REVERT_AFTER" \
      >/dev/null 2>&1 </dev/null 3>&- &
  fi

  cp "$candidate" "$AK.new"
  chmod 600 "$AK.new"
  mv -f "$AK.new" "$AK"

  if ! golden_login; then
    "$sh" "$AK.revert.sh" "$AK" "$PENDING" "$LOGFILE" 0
    rm -f "$AK.reverted"
    if golden_login; then
      warn "restored the previous $AK, and the golden key logs in again"
    else
      warn "restored the previous $AK, but the golden key STILL cannot log in: check by hand now"
    fi
    die "the new authorized_keys refused the golden key over loopback"
  fi
  ok "$AK replaced; the golden key still logs in over loopback"
  warn "it reverts in $((REVERT_AFTER / 60)) minutes unless confirmed from another host:"
  echo "  ssh -o ControlMaster=no -o ControlPath=none <this host> $REPO/scripts/install-host --confirm"

  # Keep the five most recent backups; hand-named ones (.bak-permitopen) do not match.
  baks=("$AK".bak-[0-9]*T[0-9]*)
  if [ ${#baks[@]} -gt 5 ]; then
    ls -1t "${baks[@]}" | tail -n +6 | while read -r old; do rm -f "$old"; done
  fi
}

log "Generating authorized_keys for tags: ${TAGS[*]}"
authorized_keys

touch "$HOME/.install-host.complete"
