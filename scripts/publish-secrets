#!/usr/bin/env bash
# publish-secrets - upload scripts/unpack-secrets to od:Archive/Items/
#
# Usage: publish-secrets        (from the repo root)
#
# That is where fetch-secrets finds it on a new host.

case "${1:-}" in -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;; esac

set -eo pipefail

DEST_REMOTE="od:Archive/Items/"
SRC_SCRIPT="./scripts/unpack-secrets"

rclone copy $SRC_SCRIPT $DEST_REMOTE 