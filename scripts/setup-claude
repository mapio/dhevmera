#!/usr/bin/env bash

set -eo pipefail

# Everything Claude Code gets from this repo: the global instructions, skills and the
# tag's settings.json linked into ~/.claude, and the MCP servers registered through the
# claude CLI. Kept out of
# install-dotfiles so that a host without Claude Code (the tablet: Termux cannot run it)
# gets none of it.
#
#   setup-claude [--dry-run] [--prune]
#
# Skill links left dangling by a skill removed from the repo are only reported, unless
# --prune is given.

RUN=
PRUNE=
for arg in "$@"; do
  case "$arg" in
    --dry-run) RUN=echo ;;
    --prune) PRUNE=yes ;;
    *) echo "usage: setup-claude [--dry-run] [--prune]" >&2; exit 2 ;;
  esac
done

LOGFILE="$HOME/.setup-claude.log"
exec 3>&1
exec > >(tee -a "$LOGFILE") 2>&1

source "$(dirname "${BASH_SOURCE[0]}")/install-common.sh"

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/../dotfiles" && pwd -P)"
# QBT's OpenObserve MCP server and its skill, both named qbt-openobserve, live in the
# observability repo under the NDA: only these paths appear here. The skill sits outside
# .claude/, so that repo does not load it twice.
OBSERVABILITY="$HOME/qbt-repos/observability"
QBTOBSERVE="$OBSERVABILITY/skills/qbt-openobserve"
TAGFILE="$HOME/.dhevmera-tags"

if ! command -v claude >/dev/null; then
  log "Claude Code is not installed here: nothing to do"
  exit 0
fi

TAGS=()
if [ -r "$TAGFILE" ]; then
  mapfile -t TAGS < <(read_tags "$TAGFILE")
fi
check_tags "${TAGS[@]}"

has_tag() {
  local tag
  for tag in "${TAGS[@]}"; do
    [ "$tag" = "$1" ] && return 0
  done
  return 1
}

log "Linking the global instructions and skills"

# Named instructions.md rather than CLAUDE.md so it is not also loaded as the project
# file for this directory; dotfiles/claude/README.md says why the payload looks as it does.
if [ -e "$HOME/.claude/CLAUDE.md" ] && [ ! -h "$HOME/.claude/CLAUDE.md" ]; then
  warn "~/.claude/CLAUDE.md is a plain file, left alone: carry its changes into the repo, remove it, re-run"
else
  _install "$DOTFILES/claude/instructions.md" "$HOME/.claude/CLAUDE.md"
fi

# Skills get one _install line each, not the whole directory: ~/.claude/skills/ also holds
# entries this repo does not own.
_install "$DOTFILES/claude/skills/sepolcro" "$HOME/.claude/skills/sepolcro"

if has_tag qbt; then
  if [ -d "$QBTOBSERVE" ]; then
    _install "$QBTOBSERVE" "$HOME/.claude/skills/qbt-openobserve"
  else
    warn "no '$QBTOBSERVE' yet: qbt-openobserve skill not linked"
  fi
fi

# The status line settings.json points at: generic, so every Claude host gets it.
_install "$DOTFILES/claude/statusline.sh" "$HOME/.claude/statusline.sh"

log "Linking settings.json"

# One file per tag, linked whole: no merging, so a host may carry at most one tag that has
# one. Claude Code writes into it (/effort, /model), which shows up in git status here.
settings=()
for tag in "${TAGS[@]}"; do
  [ -f "$DOTFILES/claude/settings/$tag.json" ] && settings+=("$DOTFILES/claude/settings/$tag.json")
done
dst="$HOME/.claude/settings.json"
if [ ${#settings[@]} -gt 1 ]; then
  die "tags ${TAGS[*]} have more than one settings file: ${settings[*]}"
elif [ ${#settings[@]} -eq 0 ]; then
  warn "no tag of this host has a settings file: $dst left as it is"
elif [ -f "$dst" ] && [ ! -h "$dst" ] && ! cmp -s "$dst" "${settings[0]}"; then
  warn "$dst is a plain file that differs from ${settings[0]}: carry its changes into the repo, remove it, re-run"
else
  _install "${settings[0]}" "$dst"
fi

log "Checking for skill links whose source left the repo"

for link in "$HOME"/.claude/skills/*; do
  target=$(readlink "$link") || continue
  case "$target" in
    "$DOTFILES"/claude/skills/* | "$QBTOBSERVE") ;;
    *) continue ;;
  esac
  if [ -e "$link" ]; then
    continue
  elif [ -n "$PRUNE" ]; then
    $RUN rm "$link"
    ok "removed: $link"
  else
    warn "stale: $link -> $target (re-run with --prune to remove it)"
  fi
done

log "Registering MCP servers"

# manent's index lives on svm, the pvm host: the full tools there, read-only over ssh
# elsewhere.
MANENT=/chome/santini/Activities/Programming/manent/.venv/bin/manent
if has_tag pvm; then
  manent=("$MANENT" mcp --ssh-host svm)
else
  manent=(ssh -o BatchMode=yes svm "$MANENT" mcp --read-only --ssh-host svm)
fi
# stderr only: under --dry-run, stdout is the echoed command.
$RUN claude mcp remove -s user manent 2>/dev/null || true
$RUN claude mcp add -s user manent -- "${manent[@]}"
ok "manent: ${manent[*]}"

if has_tag qbt; then
  openobserve=("$OBSERVABILITY/.venv/bin/python3" "$OBSERVABILITY/.claude/mcp/mcp-server.py")
  if [ -x "${openobserve[0]}" ] && [ -f "${openobserve[1]}" ]; then
    # 'observability' is the name it was registered under before.
    $RUN claude mcp remove -s user observability 2>/dev/null || true
    $RUN claude mcp remove -s user qbt-openobserve 2>/dev/null || true
    $RUN claude mcp add -s user qbt-openobserve -- "${openobserve[@]}"
    ok "qbt-openobserve: ${openobserve[*]}"
  else
    warn "no '${openobserve[1]}' with its .venv: qbt-openobserve not registered"
  fi
fi
