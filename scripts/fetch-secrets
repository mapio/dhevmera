#!/usr/bin/env bash

set -eo pipefail

SRC_REMOTE="od:Archive/Items/unpack-secrets"
DST_SCRIPT="./scripts/unpack-secrets"

# Mirrors pack-secrets: refuse rather than clobber, so a local pack that has not been
# published yet cannot be silently replaced by the older copy sitting on the remote.

if [ -f $DST_SCRIPT ]; then
  echo "$DST_SCRIPT already exists, please remove it before fetching again."
  exit 1
fi

rclone copyto $SRC_REMOTE $DST_SCRIPT

chmod 700 $DST_SCRIPT

echo "Fetched $DST_SCRIPT, run it to extract the secrets."
