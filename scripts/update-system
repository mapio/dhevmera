#!/usr/bin/env bash
# update-system - upgrade the packages and the tools installed under /usr/local
#
# Usage: update-system [--dry-run] [--all] [host ...]
#
#   --dry-run  print the commands instead of running them
#   --all      also update the hosts given (default: svm parsifal), by piping this
#              very script to them, so they run the copy you invoked rather than
#              whatever their own clone holds. Meant to be run from the tablet, like
#              empower.

case "${1:-}" in -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;; esac

set -eo pipefail

RUN=
ALL=

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) RUN=echo; shift ;;
    --all)     ALL=1; shift ;;
    *)         break ;;
  esac
done

if [ "$#" -gt 0 ]; then
  hosts=("$@")
else
  hosts=(svm parsifal)
fi

if [ "$(id -u)" -eq 0 ]; then
  SUDO=""
elif command -v sudo >/dev/null 2>&1; then
  SUDO="sudo"
else
  SUDO=""
fi

log() { printf "\n==> %s\n\n" "$*"; }

status=0

# Termux detected the way shell/bash_profile does it. pkg wraps apt and needs no
# sudo, there being no root on Android.

if command -v termux-setup-storage >/dev/null 2>&1; then

  log "Updating Termux packages"
  $RUN pkg upgrade -y

else

  log "Updating APT packages"
  # noninteractive because --all runs this over ssh, with no tty for dpkg to prompt on.
  $RUN $SUDO env DEBIAN_FRONTEND=noninteractive apt update
  $RUN $SUDO env DEBIAN_FRONTEND=noninteractive apt upgrade -y
  $RUN $SUDO env DEBIAN_FRONTEND=noninteractive apt autoremove -y

fi

# The VS Code CLI is a hand-installed binary in /usr/local, so apt cannot update it
# and this has to. Guarded on that path rather than on 'code' being on PATH: parsifal
# has a different code (/usr/share/code, the full editor) that this would overwrite.

CODE=/usr/local/bin/code

if [ -x "$CODE" ]; then

  case "$(dpkg --print-architecture 2>/dev/null)" in
    amd64) CODE_TARGET=cli-alpine-x64 ;;
    arm64) CODE_TARGET=cli-alpine-arm64 ;;
    *)     CODE_TARGET= ;;
  esac

  if [ -z "$CODE_TARGET" ]; then

    log "No VS Code CLI build for this architecture, skipping"

  else

    log "Updating the VS Code CLI ($("$CODE" --version | head -n1))"

    TUNNEL=code-tunnel.service
    if systemctl --user is-active --quiet "$TUNNEL" 2>/dev/null; then
      RESTART_TUNNEL=1
      $RUN systemctl --user stop "$TUNNEL"
    else
      RESTART_TUNNEL=
    fi

    # --no-same-owner for the reason 65-aichat.sh spells out: tar as root would
    # otherwise restore whatever uid the archive carries.
    if [ -z "$RUN" ]; then
      curl -#L "https://code.visualstudio.com/sha/download?os=$CODE_TARGET" \
        | $SUDO tar zxf - --no-same-owner -C /usr/local/bin
      $SUDO chmod a+rx "$CODE"
    else
      $RUN "curl -#L 'https://code.visualstudio.com/sha/download?os=$CODE_TARGET' | $SUDO tar zxf - --no-same-owner -C /usr/local/bin"
      $RUN $SUDO chmod a+rx "$CODE"
    fi

    [ -z "$RESTART_TUNNEL" ] || $RUN systemctl --user start "$TUNNEL"

    log "VS Code CLI now $("$CODE" --version | head -n1)"

  fi

fi

# herdr in /usr/local cannot update itself ('herdr update' rewrites its own binary), so
# this does, the way 67-herdr.sh installs it: upstream's checksumming install.sh into a
# scratch dir, then one sudo copy.

HERDR=/usr/local/bin/herdr

if [ -x "$HERDR" ]; then

  HERDR_INSTALLED=$("$HERDR" --version 2>/dev/null | awk '{ print $2 }')
  HERDR_LATEST=$(curl -fsSL https://herdr.dev/latest.json \
    | sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' | head -n1 || true)

  if [ -z "$HERDR_LATEST" ]; then
    log "Could not determine the latest herdr version, skipping"
  elif [ "$HERDR_INSTALLED" = "$HERDR_LATEST" ]; then
    log "herdr is current ($HERDR_INSTALLED)"
  else
    log "Updating herdr $HERDR_INSTALLED -> $HERDR_LATEST"
    if [ -z "$RUN" ]; then
      HERDR_TMP=$(mktemp -d)
      curl -fsSL https://herdr.dev/install.sh | HERDR_INSTALL_DIR="$HERDR_TMP" sh
      $SUDO install -m 755 "$HERDR_TMP/herdr" "$HERDR"
      rm -rf "$HERDR_TMP"
      log "herdr now $("$HERDR" --version | awk '{ print $2 }'): restart it, or use its live handoff"
      # A new release may carry a new Claude hook; it writes through the settings.json link.
      ! command -v claude >/dev/null || "$HERDR" integration install claude
    else
      $RUN "curl -fsSL https://herdr.dev/install.sh | HERDR_INSTALL_DIR=<tmp> sh && $SUDO install -m 755 <tmp>/herdr $HERDR"
      $RUN "$HERDR" integration install claude
    fi
  fi

fi

# The remotes run this file over stdin, so there is one version in play per run and no
# need to know where each host keeps its clone. --all is never forwarded, or they would
# hand it straight back.

if [ -n "$ALL" ]; then

  if [ ! -r "$0" ]; then
    echo "update-system: cannot re-read '$0' to send it to the remotes" >&2
    exit 1
  fi

  for host in "${hosts[@]}"; do
    log "Updating $host"
    if ssh "$host" "bash -s -- ${RUN:+--dry-run}" < "$0"; then
      :
    else
      echo "update-system: $host FAILED" >&2
      status=1
    fi
  done

fi

exit "$status"
