#!/bin/bash
# list-server-types - Hetzner Cloud server types on sale in nbg1
#
# Usage: list-server-types
#
# Columns: name, architecture, hourly gross price, cores, memory GB, disk GB,
# included traffic TB, category, CPU type. Sorted by cores, then price.

case "${1:-}" in -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;; esac

hcloud server-type list -o json | jq -r '
  .[] as $s
  | select($s.deprecated == false)
  | $s.prices[]
  | select(.location == "nbg1")
  | [
      $s.name, 
      $s.architecture,
      (.price_hourly.gross | tonumber * 10000 | floor / 10000),
      $s.cores,
      $s.memory,
      $s.disk,
      (.included_traffic / (1024*1024*1024*1024)),
      $s.category,
      $s.cpu_type
    ]
  | @tsv
' | sort -nk4,4  -nk3,3