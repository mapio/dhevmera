#!/usr/bin/env bash
# backup-cloud - restic backup of /chome/santini to OneDrive (od:Backups/cloud-home)
#
# Usage: backup-cloud
#
# Run daily by backup-cloud.timer on the host tagged pvm. RESTIC_PASSWORD comes from
# ~/.bash_secrets; output is timestamped with ts (moreutils).

case "${1:-}" in -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;; esac

set -eo pipefail

source $HOME/.bash_secrets

if [ ! -v RESTIC_PASSWORD ]; then
  echo "Missing RESTIC_PASSWORD environment variable"
  exit 1
fi

restic -r rclone:od:Backups/cloud-home backup /chome/santini 2>&1 | ts '[%F %T]'
