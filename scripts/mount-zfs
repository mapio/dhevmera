#!/usr/bin/env bash
# mount-zfs - unlock and mount the encrypted /chome volume on a cloud host
#
# Usage: mount-zfs
#
# Imports the pool, asks for the key of chome/santini and mounts it, then removes
# ~/dhevmera, the bootstrap's clone, and points ~/x at /chome/santini/x. Not for svm,
# where /chome is a plain directory.

case "${1:-}" in -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;; esac

set -eo pipefail

POOL=chome
DATASET=santini

sudo zpool import -af
sudo zfs load-key "$POOL/$DATASET" || {
  echo "Failed to load ZFS key for $POOL/$DATASET"
  exit 1
}
sudo zfs mount "$POOL/$DATASET"
rm -rf $HOME/dhevmera
rm -f $HOME/x
ln -s /chome/santini/x $HOME/x