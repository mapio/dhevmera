#!/usr/bin/env bash
#
# empower -- prime the remote agents, leave a persistent ssh master to each host,
# and exit: agent forwarding everywhere, a reverse tunnel back to this machine's
# sshd on svm alone, and a SOCKS proxy on 1080 on parsifal alone. Idempotent, so
# rerunning it is the fix for any master lost to a reboot or a network change.
#
# Meant to be run from the tablet, where there is no pinentry display for the
# remote gpg-agent: rather than priming its cache with a throwaway signature,
# the passphrase is preset straight into it. Only the signing keygrip is preset,
# so anything that *decrypts* there -- the gitgpg filter, were it ever used --
# would still want a pinentry.
#
# GPG_PASSPHRASE and SSH_PASSPHRASE come from ~/.pp, which is deliberately not
# in this repo; neither ever reaches argv or shell history. The target needs
# allow-preset-passphrase in ~/.gnupg/gpg-agent.conf (dotfiles ships it, but a
# running agent will not pick it up without gpgconf --reload gpg-agent).
#
# Usage: empower [host ...]        (default: svm parsifal)

set -euo pipefail

if [ ! -r "$HOME/.pp" ]; then
    echo "empower: ~/.pp is missing; it must export GPG_PASSPHRASE and SSH_PASSPHRASE" >&2
    exit 1
fi
source "$HOME/.pp"

KEYGRIP=7D3C82B6932A480C398251B6B13ACCD647A0BC21
CONTROL_DIR="$HOME/.ssh/sockets"
REVERSE_PORT=2222      # port opened on svm, reaching back to ...
SSHD_PORT=8022         # ... this machine's sshd, 8022 being Termux's default

: "${GPG_PASSPHRASE:?not set by ~/.pp}"
: "${SSH_PASSPHRASE:?not set by ~/.pp}"

if [ "$#" -gt 0 ]; then
    hosts=("$@")
else
    hosts=(svm parsifal)
fi

askpass=$(mktemp)
trap 'rm -f "$askpass"' EXIT
cat >"$askpass" <<'EOF'
#!/bin/sh
printf '%s' "$SSH_PASSPHRASE"
EOF
chmod 700 "$askpass"

# Android refuses /proc/net/tcp, so no port-to-pid lookup works in Termux -- not lsof,
# fuser or netstat. Our own masters are visible to pgrep, which is what we actually need.
# The ^ anchor matters: unanchored, this matches the shell running the script.
stale_masters() {
    pgrep -f "^ssh -S $CONTROL_DIR/$1 " || true
}

# -O check only asks the local process, which outlives a connection lost to sleep or a
# network change; a session through it then stalls until ServerAlive gives up.
master_alive() {
    timeout 10 ssh -S "$CONTROL_DIR/$1" "$1" true 2>/dev/null
}

# ExitOnForwardFailure does not cover -D or -L here: the bind fails, ssh says so, and the
# master starts anyway and reports success. So the forward it was meant to carry is probed
# for directly. svm's is checked as a bound listener rather than end to end, so a tablet
# with no sshd does not look like a broken tunnel.
forward_up() {
    case "$1" in
        svm)      ssh -S "$CONTROL_DIR/$1" "$1" \
                      "ss -lnt 2>/dev/null | grep -q '127.0.0.1:$REVERSE_PORT'" 2>/dev/null ;;
        parsifal) bash -c "</dev/tcp/127.0.0.1/1080" 2>/dev/null ;;
        *)        true ;;
    esac
}

# ssh reports a refused bind on stderr and carries on, so that is the signal that actually
# distinguishes our forward from someone else's listener. Leaves ssh's stderr in $err.
start_master() {
    err=$(ssh -S "$sock" -M -N -f "${extra_flags[@]}" "$host" 2>&1) &&
        ! grep -qE "cannot listen to port|Address already in use" <<<"$err" &&
        forward_up "$host"
}

# A lost master leaves its -R bound on svm for ~2h (see CLAUDE.md); ours is retired by now,
# so the holder is that orphan. sudo because sshd's fds are invisible to a plain fuser.
clear_reverse_orphan() {
    grep -q "remote port forwarding failed" <<<"$err" || return 1
    echo "  $label: killing orphaned listener on $host:$REVERSE_PORT" >&2
    ssh -S "$sock" -O exit "$host" >/dev/null 2>&1 || true
    rm -f "$sock"
    ssh "$host" "sudo -n fuser -k $REVERSE_PORT/tcp" >/dev/null 2>&1 || return 1
    sleep 1
}

# ssh-add -l exits 0 once *any* identity is resident -- coarse, but enough to
# avoid re-prompting for a key that's almost certainly already loaded.
if ssh-add -l >/dev/null 2>&1; then
    echo "ssh-add: already loaded"
else
    # setsid detaches the controlling tty and SSH_ASKPASS_REQUIRE=force makes
    # ssh-add use SSH_ASKPASS regardless, so the passphrase never touches a
    # prompt.
    SSH_ASKPASS="$askpass" SSH_ASKPASS_REQUIRE=force setsid ssh-add </dev/null
    echo "ssh-add: added"
fi
ssh-add -l | sed 's/^/  /'

mkdir -p -m 700 "$CONTROL_DIR"

status=0
for host in "${hosts[@]}"; do
    printf '== %s ==\n' "$host"

    if printf '%s' "$GPG_PASSPHRASE" | ssh "$host" "
        set -euo pipefail
        gpgconf --kill gpg-agent
        gpgconf --launch gpg-agent
        lib=\$(gpgconf --list-dirs libexecdir)
        \"\$lib/gpg-preset-passphrase\" --preset $KEYGRIP
    "; then
        echo "  gpg: ok"
    else
        echo "  gpg: FAILED" >&2
        status=1
    fi

    sock="$CONTROL_DIR/$host"
    # Kept for the -R, where it does work; forward_up is what actually guarantees this.
    extra_flags=(-o ExitOnForwardFailure=yes)
    label="agent"
    hint=
    if [ "$host" = svm ]; then
        # svm only: it is the personal machine, and parsifal has other accounts
        # that could reach a loopback port there. Everywhere else jumps through
        # svm, which is what the tablet entry in dotfiles/ssh/config arranges.
        extra_flags+=(-R "$REVERSE_PORT:localhost:$SSHD_PORT")
        label="$label+reverse:$REVERSE_PORT"
        hint=" (see what holds it: ssh $host sudo ss -ltnp sport = :$REVERSE_PORT)"
    fi
    if [ "$host" = parsifal ]; then
        extra_flags+=(-D 1080)
        label="$label+socks:1080"
        hint=" (a stale listener on 1080 on this machine will do it)"
    fi
    if ssh -S "$sock" -O check "$host" >/dev/null 2>&1 && master_alive "$host" &&
       forward_up "$host"; then
        echo "  $label: already up"
    else
        # No usable master: there was never one, it died without cleaning up (ssh crash,
        # network drop, or this machine rebooted -- CONTROL_DIR survives a reboot even
        # though every ssh process it pointed to does not), or it is alive on a dead
        # connection. A stale socket *file* alone makes the new master's bind() fail, and
        # a master that outlived its socket still holds whatever it forwarded, blocking the
        # new -D or -R. Clear both before starting a fresh one.
        ssh -S "$sock" -O exit "$host" >/dev/null 2>&1 || true
        rm -f "$sock"
        pids=$(stale_masters "$host")
        if [ -n "$pids" ]; then
            echo "  $label: retiring orphaned master(s): $(echo $pids | tr '\n' ' ')" >&2
            kill $pids 2>/dev/null || true
            sleep 1
            pids=$(stale_masters "$host")
            [ -z "$pids" ] || kill -9 $pids 2>/dev/null || true
        fi
        # On failure retire the useless master too, or the next run calls it already up.
        if start_master ||
           { [ "$host" = svm ] && clear_reverse_orphan && start_master; }; then
            echo "  $label: started"
        else
            [ -z "$err" ] || printf '%s\n' "$err" | sed 's/^/  /' >&2
            echo "  $label: FAILED$hint" >&2
            ssh -S "$sock" -O exit "$host" >/dev/null 2>&1 || true
            status=1
        fi
    fi
done

exit "$status"
