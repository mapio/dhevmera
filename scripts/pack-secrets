#!/usr/bin/env bash
# pack-secrets - encrypt secrets/ into the self-extracting scripts/unpack-secrets
#
# Usage: pack-secrets        (from the repo root)
#
# tar | gpg --symmetric (AES256, OCB), asking for the passphrase. Refuses when
# scripts/unpack-secrets exists. The pack carries secrets/.git and replaces a
# receiving host's wholesale, so check git -C secrets status on every host first.

case "${1:-}" in -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;; esac

set -eo pipefail

SRC_DIR="./secrets"
DST_SCRIPT="./scripts/unpack-secrets"

if [ ! -d $SRC_DIR ]; then
  echo "No $SRC_DIR directory found, nothing to pack."
  exit 1
fi

if [ -f $DST_SCRIPT ]; then
  echo "$DST_SCRIPT already exists, please remove it before packing again."
  exit 1
fi

cat > $DST_SCRIPT <<'SCRIPT'
#!/usr/bin/env bash
# unpack-secrets - extract the secrets packed into this script into secrets/
#
# Usage: unpack-secrets
#
# Generated by pack-secrets. Asks for the passphrase, and does nothing when secrets/
# already exists: move an old one aside first.

case "${1:-}" in -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;; esac

set -eo pipefail

# Extracts into the repo this script sits in, whose scripts/ fetch-secrets copies it to
SECRETS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

if [[ -d "$SECRETS_DIR/secrets" ]]; then
  echo "The directory '$SECRETS_DIR/secrets' directory already exists, nothing to do."
  exit 0
fi

mkdir -p "$SECRETS_DIR"

read -r -s -p "Enter the secrets passphrase: " pw </dev/tty && printf '\n' >/dev/tty
gpg --decrypt --pinentry-mode loopback --passphrase-fd 3 3<<<"$pw" <<'EOF' | tar xvf - -C "$SECRETS_DIR"
SCRIPT

tar cf - $SRC_DIR \
  | gpg >> $DST_SCRIPT \
    --symmetric --armor \
    --cipher-algo AES256 \
    --s2k-digest-algo SHA512 \
    --s2k-mode 3 \
    --s2k-count 65011712 \
    --force-aead --aead-algo OCB \
    --compress-algo none  

cat >> $DST_SCRIPT <<'SCRIPT'
EOF

echo "Secrets decrypted into $SECRETS_DIR/secrets"
chmod -R 700 "$SECRETS_DIR/secrets"

touch $HOME/.unpack-secrets.complete

SCRIPT

chmod 700 $DST_SCRIPT



